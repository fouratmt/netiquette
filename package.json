{
  "name": "netiquette",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build && node scripts/create-pages-404.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=mobile-chromium",
    "test:cross-browser": "playwright test",
    "audit:production": "pnpm audit --prod --audit-level high",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "verify:pages": "node scripts/verify-pages-build.mjs",
    "verify:budget": "node scripts/verify-performance-budget.mjs",
    "check": "vue-tsc --noEmit && vitest run && pnpm build"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.15",
    "qrcode.vue": "^3.10.0",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.0",
    "@vue/test-utils": "^2.5.0",
    "chrome-launcher": "^1.0.0",
    "happy-dom": "^18.0.1",
    "lighthouse": "^13.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
